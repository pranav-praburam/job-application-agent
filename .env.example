# LLM provider — CrewAI uses OpenAI-compatible APIs by default
OPENAI_API_KEY=sk-...

# Optional: use a different model
# OPENAI_MODEL_NAME=gpt-4o

# Optional: use Anthropic Claude instead
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=dummy  # still required by crewai even when using Anthropic

# Dashboard port (default: 5000)
DASHBOARD_PORT=8080

# Database path (relative to project root)
DATABASE_PATH=data/applications.db

# Job search preferences
TARGET_ROLES=Software Engineer,Backend Engineer,Python Developer
TARGET_LOCATIONS=Remote,San Francisco CA,New York NY
